{
  "name": "rulman-teklif",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node --env-file-if-exists=.env server/index.js",
    "admin:password": "node scripts/admin-password.js",
    "test:server": "node --test tests/server.test.js",
    "test:browser": "node tests/browser-audit.mjs",
    "test:site": "node tests/site.test.js",
    "prebuild": "node scripts/check-public-env.mjs",
    "test:supabase": "node --test tests/supabase-auth.test.mjs",
    "test:supabase:db": "node --test --test-concurrency=1 tests/supabase-db.test.mjs tests/supabase-import.test.mjs",
    "supabase:dry-run": "node scripts/supabase/import.mjs",
    "supabase:migrate": "node --env-file-if-exists=.env.local scripts/supabase/migrate.mjs",
    "supabase:import": "node --env-file-if-exists=.env.local scripts/supabase/import.mjs",
    "supabase:bootstrap": "node --env-file-if-exists=.env.local scripts/supabase/bootstrap-admin.mjs",
    "test:supabase:read": "node --test tests/supabase-read.test.mjs",
    "test:catalog:additions": "node --test tests/catalog-additions.test.js",
    "dev:admin": "npm run dev --workspace=@rt/admin",
    "build:admin": "npm run build --workspace=@rt/admin",
    "build:pages": "node scripts/build-pages.mjs",
    "test:admin": "node --test tests/admin/contracts.test.mjs tests/admin/dashboard-contracts.test.mjs",
    "test:admin:browser": "node tests/admin/auth.browser.mjs",
    "test:admin:db": "node --test --test-concurrency=1 tests/admin/security-db.test.mjs tests/admin/dashboard-db.test.mjs",
    "dev:admin:local": "node scripts/admin-local-test.mjs",
    "test:admin:dashboard:browser": "node tests/admin/dashboard.browser.mjs",
    "admin:prepare-media": "node scripts/admin-prepare-media.mjs",
    "test:admin:catalog": "node --test --test-concurrency=1 tests/admin/catalog-contracts.test.mjs tests/admin/catalog-media.test.mjs tests/admin/catalog-db.test.mjs",
    "test:admin:catalog:browser": "node tests/admin/catalog.browser.mjs",
    "test:admin:edge:types": "DENO_DIR=/tmp/rt-deno deno check --node-modules-dir=manual supabase/functions/rt-catalog-media/index.ts",
    "build:complete": "node scripts/build-complete.mjs",
    "test:workspace": "node --test --test-concurrency=1 tests/admin/workspace-db.test.mjs tests/admin/gateway.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "lucide-react": "^0.577.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/parser": "^8.0.10",
    "@imagemagick/magick-wasm": "0.0.35",
    "deno": "2.5.6",
    "lighthouse": "^13.6.0",
    "pdf-lib": "1.17.1",
    "playwright": "^1.64.1",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/admin",
    "packages/contracts"
  ]
}
