[Unit]
Description=Rulman Teklif website and quote service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rulmanteklif
Group=rulmanteklif
WorkingDirectory=/opt/rulmanteklif
EnvironmentFile=/etc/rulmanteklif.env
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=300
StateDirectory=rulmanteklif
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rulmanteklif

[Install]
WantedBy=multi-user.target
