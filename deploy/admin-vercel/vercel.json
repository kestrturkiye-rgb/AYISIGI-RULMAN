{
  "version": 2,
  "builds": [
    {
      "src": "api/collect.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/quote.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/retention.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "admin/**",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "fonts/**",
      "use": "@vercel/static"
    },
    {
      "src": "brand/**",
      "use": "@vercel/static"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "Strict-Transport-Security": "max-age=31536000; includeSubDomains"
      },
      "continue": true
    },
    {
      "src": "/api/collect",
      "dest": "/api/collect.mjs"
    },
    {
      "src": "/api/quote",
      "dest": "/api/quote.mjs"
    },
    {
      "src": "/api/retention",
      "dest": "/api/retention.mjs"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/admin/?",
      "dest": "/admin/index.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/retention",
      "schedule": "17 2 * * *"
    }
  ]
}
