{
  "version": 2,
  "builds": [
    {
      "src": "api/auth/[action].mjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/collect.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/quote.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/retention.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "admin/**",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "fonts/**",
      "use": "@vercel/static"
    },
    {
      "src": "brand/**",
      "use": "@vercel/static"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
        "Content-Security-Policy": "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://kestrturkiye-rgb.github.io https://lptosaejlowasrbcyqnu.supabase.co; font-src 'self'; connect-src 'self' https://lptosaejlowasrbcyqnu.supabase.co wss://lptosaejlowasrbcyqnu.supabase.co https://rulman-teklif-admin.vercel.app; worker-src 'self' blob:; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
      },
      "continue": true
    },
    {
      "src": "/api/auth/(session|login|logout|signup|recover|callback|password|delete-account)",
      "dest": "/api/auth/[action].mjs?action=$1"
    },
    {
      "src": "/api/collect",
      "dest": "/api/collect.mjs"
    },
    {
      "src": "/api/quote",
      "dest": "/api/quote.mjs"
    },
    {
      "src": "/api/retention",
      "dest": "/api/retention.mjs"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/admin/?",
      "dest": "/admin/index.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/retention",
      "schedule": "17 2 * * *"
    }
  ]
}
