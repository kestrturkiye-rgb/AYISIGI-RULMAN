# Node.js 24+. Full-stack build: npm run build (root base URL).
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=https://example.com
# Set to 1 only behind the single local reverse proxy in deploy/Caddyfile.
TRUST_PROXY_HOPS=1
# Must be on a persistent disk, outside the public/dist directories.
DATA_DIR=/var/lib/rulmanteklif
# Generate interactively with npm run admin:password; never use a plaintext password here.
ADMIN_PASSWORD_HASH=
# Use the mail provider's authenticated, TLS-enabled SMTP service.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Rulman Teklif <info@rulmanteklif.com>"

# Phase 1: browser settings are public. Leave empty until a Supabase project exists.
# Never put a service-role/secret key in any VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy public anon key instead of publishable key:
VITE_SUPABASE_ANON_KEY=
# Optional explicit legacy Node admin, not a fallback from failed Supabase auth:
# VITE_ADMIN_AUTH_PROVIDER=legacy

# Trusted CLI/import only. NEVER use a VITE_ prefix for these.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# static: mevcut JSON katalog; supabase: canlı veritabanı (migration 004 gerekir)
VITE_DATA_SOURCE=static

# Ayrı admin uygulaması. Pages build komutu bu base yolunu otomatik ayarlar.
# VITE_ADMIN_BASE=/AYISIGI-RULMAN/admin/
# Yerel test bayrağını production ortamına eklemeyin.
# Canlı e-posta/şifre girişi için Supabase Auth redirect allowlist:
# https://kestrturkiye-rgb.github.io/AYISIGI-RULMAN/admin/
