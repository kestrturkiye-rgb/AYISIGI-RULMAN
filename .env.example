# Node.js 24+. Full-stack build: npm run build (root base URL).
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=https://example.com
# Set to 1 only behind the single local reverse proxy in deploy/Caddyfile.
TRUST_PROXY_HOPS=1
# Must be on a persistent disk, outside the public/dist directories.
DATA_DIR=/var/lib/rulmanteklif
# Generate interactively with npm run admin:password; never use a plaintext password here.
ADMIN_PASSWORD_HASH=
# Use the mail provider's authenticated, TLS-enabled SMTP service.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Rulman Teklif <info@rulmanteklif.com>"
